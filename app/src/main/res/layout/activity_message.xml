<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/root_message_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7EA">

    <RelativeLayout
        android:id="@+id/custom_toolbar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#FFF7EA"
        android:elevation="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_custom_back"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chat_toolbar_icon"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            app:srcCompat="?attr/homeAsUpIndicator"
            app:tint="#2B241D" />

        <TextView
            android:id="@+id/tv_room_title"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="맛남의 광장"
            android:textColor="#1F1A14"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_chat_menu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chat_toolbar_icon"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="채팅 메뉴"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#2B241D" />

    </RelativeLayout>

    <View
        android:id="@+id/view_toolbar_bottom_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EFDCC4"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_chat_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/view_toolbar_bottom_line"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_message_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingTop="14dp"
            android:paddingEnd="4dp"
            android:paddingBottom="18dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_chat_input_bar"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/btn_select_image"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_chat_icon_button_warm"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="이미지 선택"
                app:tint="#FF7A1A" />




            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input_warm"
                android:gravity="center_vertical|start"
                android:hint="메시지를 입력하세요"
                android:imeOptions="flagNoEnterAction"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="48dp"
                android:maxHeight="120dp"
                android:maxLines="5"
                android:overScrollMode="always"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:singleLine="false"
                android:textColor="#241C14"
                android:textColorHint="#B3A89B"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="68dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_chat_send_button_warm"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="전송"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/view_member_panel_dim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#70000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_member_panel"
        android:layout_width="292dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_member_panel_warm"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:translationX="292dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/custom_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_member_panel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_member_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="채팅 참여자"
                android:textColor="#1F1A14"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_member_panel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_toolbar_icon"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="참여자 패널 닫기"
                app:tint="#5A4C3E" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="같이 먹고 이야기하는 사람들"
            android:textColor="#9B8875"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_invite_from_member_panel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel_orange_button_warm"
            android:text="+ 친구 초대"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_share_invite_link"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_panel_outline_button_warm"
            android:text="초대 링크 복사"
            android:textColor="#FF7A1A"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:background="#F0DEC9" />

        <TextView
            android:id="@+id/tv_member_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="참여자 목록을 불러오는 중..."
            android:textColor="#8C8175"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_member_panel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_leave_chat_room"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel_leave_button_warm"
            android:text="채팅방 나가기"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>